{
  "name": "neuralflow",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time MLOps dashboard for deploying, monitoring, and safely rolling out machine learning models.",
  "scripts": {
    "dev": "next dev",
    "predev": "prisma generate",
    "typecheck": "tsc --noEmit --incremental false",
    "pretypecheck": "prisma generate",
    "build": "next build --webpack",
    "prebuild": "prisma generate",
    "postbuild": "cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db": "npm run db:init",
    "db:init": "node scripts/init-empty-database.mjs",
    "auth:bootstrap": "node --env-file=.env --import tsx scripts/bootstrap-admin.mts",
    "db:seed:demo": "node --import tsx prisma/seed-demo.ts",
    "traffic:demo": "node --import dotenv/config scripts/generate-demo-traffic.mjs",
    "test": "node --import dotenv/config --import tsx --test tests/registry.test.mts tests/deployment-lifecycle.test.mts tests/advanced-routing.test.mts tests/monitoring.test.mts",
    "test:routing": "node --import dotenv/config --import tsx --test tests/advanced-routing.test.mts",
    "test:inference": "node --import dotenv/config --import tsx --test tests/inference.test.mts",
    "test:security": "node --import dotenv/config --import tsx --test tests/security-unit.test.mts tests/security-http.test.mts",
    "test:ui": "node --import dotenv/config --import tsx tests/ui-smoke.mts",
    "env:init": "node scripts/env-init.mjs",
    "demo:setup": "node --import dotenv/config scripts/demo-setup.mjs",
    "demo:check": "node --import dotenv/config scripts/demo-check.mjs",
    "demo:traffic": "node --import dotenv/config scripts/generate-demo-traffic.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "latest",
    "better-auth": "^1.7.7",
    "clsx": "latest",
    "dotenv": "^17.4.2",
    "lucide-react": "latest",
    "next": "^16.4.0",
    "pg": "^8.16.3",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.1",
    "postcss": "latest",
    "prisma": "^7.10.0",
    "tailwindcss": "latest",
    "tsx": "^4.22.3",
    "typescript": "latest"
  }
}

# Local development only. Matches the PostgreSQL service in docker-compose.yml.
# Set a different password and connection URL outside local development.
DATABASE_URL="postgresql://neuralflow:neuralflow@localhost:5432/neuralflow"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Persistent artifact files for local development. Back up this directory with the database.
ARTIFACT_STORAGE_DIR="./var/artifacts"
# The Docker Compose inference service publishes only on the host loopback interface.
INFERENCE_RUNTIME_URL="http://127.0.0.1:8001"
INFERENCE_RUNTIME_GREEN_URL="http://127.0.0.1:8002"
INFERENCE_RUNTIME_TOKEN="replace-with-a-random-secret-at-least-32-characters"
BETTER_AUTH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Monitoring thresholds for a five-minute inference window.
MONITOR_SLO_P95_MS="80"
MONITOR_SLO_SUCCESS_PERCENT="99"
MONITOR_DRIFT_THRESHOLD="0.5"
MONITOR_ALERT_MIN_REQUESTS="20"

# Run npm run env:init to fill these local-only account values securely.
NEURALFLOW_ADMIN_EMAIL="admin@example.test"
NEURALFLOW_ADMIN_PASSWORD=""
